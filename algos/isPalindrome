O(1)
class Solution {
public:
    bool isPalindrome(string s) {
       int left=0;
       int right=s.size()-1;
       while(left<right){
            while(left<right && !isalnum(s[left])){
                left+=1;
            }
            while(left<right && !isalnum(s[right])){
                right-=1;
            }
            if (tolower(s[left])!=tolower(s[right])){
                    return false;
            }
            left++;
            right--;
       }
       return true;
    }
};
O(n)



class Solution {
public:
    bool isPalindrome(string s) {
        string clean;
        for (char c: s){
            if (isalnum(c)){
                clean+=tolower(c);
            }
        }
        string result = clean;
        reverse(result.begin(),result.end());
        return result==clean;
    }
};
