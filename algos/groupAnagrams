class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string, vector<string>> seen;
        
        for (const string& s : strs) {
            int count[26] = {0};
            for (char c : s) count[c - 'a']++;
            
            string key;
            for (int i = 0; i < 26; i++) {
                key += to_string(count[i]);
                key += '#';
            }
            seen[key].push_back(s);
        }
        
        vector<vector<string>> result;
        for (auto& [key, vec] : seen) {
            result.push_back(move(vec));
        }
        return result;
    }
};
class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string,vector<string>> seen;
        for (const string& i:strs){
           string key=i;
           sort(key.begin(),key.end());
           seen[key].push_back(i);
        }
        vector<vector<string>> se;
        for (auto& [key,vec] : seen){
            se.push_back(vec);
        }
        return se;

    }
};
